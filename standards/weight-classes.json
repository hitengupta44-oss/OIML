  "usage_rule": {
    "clause": "Legal Metrology (General) Rules, 2011 — Seventh Schedule, Heading A, Part II",
    "rule": "The maximum permissible error for the standard weights must not exceed one third of the maximum permissible error of the instrument for the applied load.",
    "expression": "sum(mpe_weight_mg) / 1000 <= mpe_instrument_g / 3",
    "note": "The Indian schedule additionally states that the error of the standard weight in air shall not exceed one quarter of its maximum permissible error in the application referred to there. Record which rule was applied."
